rules_version = '2';

// Flickémon save data.
// Deploy with:  firebase deploy --only firestore:rules,firestore:indexes
//   (or paste into Firebase console → Firestore → Rules → Publish)
//
// ⚠️ TWO things must be deployed, not one. The global leaderboard runs an
// ordered query, and Firestore answers an un-indexed query with an ERROR rather
// than an empty list — so firestore.indexes.json has to go up as well or the
// board is broken while everything else looks fine.
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Keep in sync with ALLOWED_EMAIL_DOMAINS in background/firebase-config.js.
    // THIS is the real restriction: the extension's copy is only for a friendly
    // error message and can be edited out by anyone running it unpacked.
    function allowedDomain() {
      return request.auth.token.email.matches('.*@docchula[.]com');
    }

    function signedInStudent() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && allowedDomain();
    }

    // Each student owns exactly one save document, keyed by their Firebase uid.
    // They can read and write only their own; nobody can read anyone else's.
    //
    // ── The wallet ──
    //
    // moneyEarned and moneySpent are lifetime counters, hoisted out of the save
    // blob by background/firestore.js precisely so these rules can see them: a
    // rule cannot look inside a JSON string.
    //
    // serverAt is stamped by Firestore itself, via an updateTransform on the
    // commit, and pinned below to request.time. That is the load-bearing part.
    // updatedAt sits in the same document but is written from the DEVICE's
    // clock, so a limit measured against it would be a limit the client sets —
    // and a student whose laptop clock is wrong would be locked out of syncing
    // altogether, which is a worse failure than being cheated.
    //
    // What this enforces, on the server, for real:
    //
    //   1. Neither counter can ever go down. A client cannot un-spend
    //      something, and a stale device cannot walk the ledger backwards.
    //   2. Money is minted no faster than MAX_EARN_PER_HOUR. The honest ceiling
    //      is about 171/hour — one encounter every 2.5 minutes, every one of
    //      them a paying capture — so 240 leaves real headroom for a good run
    //      while still refusing anything that is not gameplay.
    //   3. The window is capped at a day, so going dark for a week does not
    //      bank a week's allowance to spend in one write.
    //
    // What it does NOT do, stated plainly: it cannot stop someone editing
    // chrome.storage.local and spending forged money on their own machine. The
    // same has always been true of the party, the Pokédex and expDebt. What it
    // does mean is that forged money can never be PERSISTED or reach a second
    // device — the commit is rejected outright — so nothing another student can
    // see, trade with, or be matched against is affected by it.
    function saveWalletOk() {
      let before = resource.data;
      let after = request.resource.data;
      let hadWallet = 'moneyEarned' in before;
      let earnedBefore = hadWallet ? before.moneyEarned : 0;
      let spentBefore = hadWallet ? before.moneySpent : 0;
      // Server time on both sides, or no time at all.
      let elapsed = ('serverAt' in before)
          ? request.time.toMillis() - before.serverAt.toMillis()
          : -1;
      let window = elapsed < 0 ? 0 : (elapsed > 86400000 ? 86400000 : elapsed);
      // 240/hour, plus a small allowance for the rounding either side of a
      // three-minute push. A save written before serverAt existed has no
      // trustworthy clock to measure against, so it falls back to the coarse
      // per-write ceiling rather than locking that student out.
      let allowance = ('serverAt' in before) ? (240 * window) / 3600000 + 50 : 3000;
      return after.moneyEarned >= earnedBefore
             && after.moneySpent >= spentBefore
             && (!hadWallet || after.moneyEarned - earnedBefore <= allowance);
    }

    match /saves/{uid} {
      allow read: if signedInStudent() && request.auth.uid == uid;
      // A first save has nothing to be measured against.
      allow create: if signedInStudent() && request.auth.uid == uid;
      allow update: if signedInStudent() && request.auth.uid == uid
                    // serverAt, when written, must BE the commit time. Without
                    // this the client could back-date it and hand itself an
                    // arbitrarily large allowance on the following write.
                    && (!('serverAt' in request.resource.data)
                        || request.resource.data.serverAt == request.time)
                    // The counters cannot be dropped once they exist, or a
                    // client could clear them and start again from anything.
                    && (!('moneyEarned' in resource.data)
                        || 'moneyEarned' in request.resource.data)
                    && (!('moneyEarned' in request.resource.data) || saveWalletOk());
      allow delete: if signedInStudent() && request.auth.uid == uid;
    }

    // Admin roster. Presence of admins/{uid} grants admin.
    //
    // Read is limited to your own document, so nobody can enumerate the admin
    // list. Writes are denied to EVERY client — admin is granted only by
    // creating the document by hand in the Firebase console. That is what makes
    // this a real control instead of the old hardcoded passcode, which anyone
    // could read straight out of the extension's source.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // PVP battles, keyed by the host's 6-digit code.
    //
    // Knowing the code is what grants access — it is shared deliberately, the
    // way a lobby code is. Reads are open to any signed-in student because you
    // must read a lobby to discover whether it is free. Writes are restricted
    // to the two participants: an empty guest slot may be claimed, but once
    // taken, only the host and that guest can touch the document, so a third
    // student cannot hijack a match in progress.
    match /battles/{code} {
      allow read: if signedInStudent();

      allow create: if signedInStudent()
                    && request.resource.data.host == request.auth.uid;

      allow update: if signedInStudent()
                    && (resource.data.host == request.auth.uid
                        || resource.data.guest == request.auth.uid
                        || resource.data.guest == '');

      // Only the host tears their own lobby down.
      allow delete: if signedInStudent() && resource.data.host == request.auth.uid;
    }

    // Trades, keyed by the host's 6-digit code — the same code PVP uses.
    //
    // Same shape as battles above, and the same reasoning: the code is shared
    // deliberately, reads are open to any signed-in student because you must
    // read a table to know whether it is free, and writes are limited to the
    // two people at it.
    //
    // ⚠️ These rules cannot make a trade atomic. Nothing here validates that a
    // trainer owns what they put on the table, or that both sides applied the
    // swap — see the note at the top of background/trade.js. Trading is for
    // people who know each other.
    match /trades/{code} {
      allow read: if signedInStudent();

      allow create: if signedInStudent()
                    && request.resource.data.host == request.auth.uid;

      allow update: if signedInStudent()
                    && (resource.data.host == request.auth.uid
                        || resource.data.guest == request.auth.uid
                        || resource.data.guest == '');

      // Only the host clears their own table.
      allow delete: if signedInStudent() && resource.data.host == request.auth.uid;
    }

    // ───────────────────────── The friend system ─────────────────────────
    //
    // These rules ARE the privacy settings. Every toggle in the friends screen
    // works by changing what gets written, never by asking a client not to
    // display something — because the client is on the student's own disk and
    // can be edited. Rules gate whole documents and cannot filter fields, so
    // the design is "publish what you chose to share": a disabled field is
    // absent, and a blocked friend is absent from the audience list.

    function isMine(uid) {
      return signedInStudent() && request.auth.uid == uid;
    }

    // Name claims. Create-only-if-absent is what Firestore's `create` already
    // means, so a name cannot be taken from someone who holds it; only the
    // holder can release or repoint their own.
    match /usernames/{name} {
      allow read: if signedInStudent();
      allow create: if signedInStudent()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedInStudent()
                            && resource.data.uid == request.auth.uid;
    }

    // Lookup by email WITHOUT storing an email: the document id is a hash of
    // the address, so it can only be found by someone who already knows it.
    // Reading the whole collection tells an attacker nothing but hashes.
    match /emailKeys/{hash} {
      allow read: if signedInStudent();
      allow create: if signedInStudent()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedInStudent()
                            && resource.data.uid == request.auth.uid;
    }

    // Readable by the whole cohort, which is exactly why it must never carry an
    // email address or any progress — only a name someone chose to publish.
    match /profiles/{uid} {
      allow read: if signedInStudent();
      allow write: if isMine(uid);
    }

    // One document per pair, id-ordered so both sides address the same one.
    // `members` is pinned on update: without that, either side could rewrite
    // who the friendship is with and read a stranger's feed through it.
    match /friendships/{pairKey} {
      allow read: if signedInStudent() && request.auth.uid in resource.data.members;

      allow create: if signedInStudent()
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() == 2
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.accepted == false;

      // The presence checks come first on purpose. Reading a field that is not
      // in the incoming write raises an EVALUATION ERROR rather than returning
      // false — which still denies, so the behaviour was right, but it denies
      // by throwing. That reads as a broken rule in the emulator log and would
      // send anyone debugging a legitimate refusal hunting in the wrong place.
      allow update: if signedInStudent()
                    && request.auth.uid in resource.data.members
                    && 'members' in request.resource.data
                    && 'requestedBy' in request.resource.data
                    && request.resource.data.members == resource.data.members
                    && request.resource.data.requestedBy == resource.data.requestedBy;

      // Either side can walk away.
      allow delete: if signedInStudent() && request.auth.uid in resource.data.members;
    }

    // The feed a student publishes about themselves. `audience` lists exactly
    // who may read it, and it is checked from the document itself rather than
    // with get() on the friendship — a get() would cost a read per evaluation
    // and count against the 10-lookup limit.
    //
    // The audience is written by the owner, so a student who has not accepted
    // you, or who has blocked you, simply never put you in it.
    match /feeds/{uid} {
      allow read: if signedInStudent()
                  && (request.auth.uid == uid
                      || request.auth.uid in resource.data.audience);
      allow write: if isMine(uid);
    }

    // The global board. Cohort-readable, so:
    //   - the row exists only once a student opts in, and deleting it is how
    //     they leave;
    //   - it carries a LABEL, never an email — the extension truncates before
    //     writing, so a full address never reaches this document at all;
    //   - only the owner may write their own row, so nobody can post a score
    //     for someone else or tamper with a rival's.
    match /leaderboard/{uid} {
      allow read: if signedInStudent();
      allow write: if isMine(uid);
    }

    // Default deny. Any collection not matched above is unreachable by clients.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
