rules_version = '2';

// Flickémon save data.
// Deploy with:  firebase deploy --only firestore:rules
//   (or paste into Firebase console → Firestore → Rules → Publish)
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Keep in sync with ALLOWED_EMAIL_DOMAINS in background/firebase-config.js.
    // THIS is the real restriction: the extension's copy is only for a friendly
    // error message and can be edited out by anyone running it unpacked.
    function allowedDomain() {
      return request.auth.token.email.matches('.*@docchula[.]com');
    }

    function signedInStudent() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && allowedDomain();
    }

    // Each student owns exactly one save document, keyed by their Firebase uid.
    // They can read and write only their own; nobody can read anyone else's.
    match /saves/{uid} {
      allow read, write: if signedInStudent() && request.auth.uid == uid;
    }

    // Admin roster. Presence of admins/{uid} grants admin.
    //
    // Read is limited to your own document, so nobody can enumerate the admin
    // list. Writes are denied to EVERY client — admin is granted only by
    // creating the document by hand in the Firebase console. That is what makes
    // this a real control instead of the old hardcoded passcode, which anyone
    // could read straight out of the extension's source.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // PVP battles, keyed by the host's 6-digit code.
    //
    // Knowing the code is what grants access — it is shared deliberately, the
    // way a lobby code is. Reads are open to any signed-in student because you
    // must read a lobby to discover whether it is free. Writes are restricted
    // to the two participants: an empty guest slot may be claimed, but once
    // taken, only the host and that guest can touch the document, so a third
    // student cannot hijack a match in progress.
    match /battles/{code} {
      allow read: if signedInStudent();

      allow create: if signedInStudent()
                    && request.resource.data.host == request.auth.uid;

      allow update: if signedInStudent()
                    && (resource.data.host == request.auth.uid
                        || resource.data.guest == request.auth.uid
                        || resource.data.guest == '');

      // Only the host tears their own lobby down.
      allow delete: if signedInStudent() && resource.data.host == request.auth.uid;
    }

    // Default deny. Any collection not matched above is unreachable by clients.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
